#!/bin/bash

#SBATCH --job-name=burgers_fno_full_traj_mean_unc_internal_test
#SBATCH --mail-user=enaegele@umich.edu
#SBATCH --mail-type=BEGIN,END,FAIL

## export=NONE makes it so that environments already active in the terminal do not affect the env setup here
#SBATCH --export=NONE

#SBATCH --account=tewaria0
#SBATCH --partition=gpu

#SBATCH --nodes=1
#SBATCH --gpus=v100:1
#SBATCH --cpus-per-gpu=1
## mem is CPU memory - the GPU automatically gets the entire VRAM
#SBATCH --mem=8GB

## wall time hours:minutes:seconds
#SBATCH --time=0:20:00
#SBATCH --output=outputs/%x_%j.out
#SBATCH --error=errors/%x_%j.err

###   Load software modules

module purge
module load mamba/py3.12
module list

####  Commands your job should run follow this line

cd /scratch/tewaria_root/tewaria0/enaegele/active_operator_learning

echo "Running on $SLURM_JOB_NODELIST"
echo "Running in $(pwd)"

## this line finds my wandb key
source ~/.secrets/wandb.env

source "$(conda info --base)/etc/profile.d/conda.sh"

conda activate /home/enaegele/.conda/envs/al-env-gpu2

echo "Python path:"
which python

echo "Python version:"
python --version

python -m scripts.al_submitit -m \
+experiment=burgers \
+experiment/sub_exp=power \
acquisition/data_schedule=linear \
prob_model=mean_unc_internal \
prob_model/model_wrapper=fno_full_traj_mean_unc_internal \
task.data_gen.num_initial_batches=1 \
task.data_gen.batch_size=3 \
num_al_iter=2 \
num_epochs=2 \
prob_model.model_wrapper.batch_size=64 \
prob_model.model_wrapper.optimizer.lr=3e-4 \
wandb.name=burgers_fno_full_traj_mean_unc_internal_test_run \
warm_start_weights=True \
hydra=base


