#!/bin/bash
# Created by the ARC-TS SLURM job script generator for use on Great Lakes
# Thu Jun 04 2026 15:53:52 GMT-0400 (Eastern Daylight Time)

# The name of the job:
#SBATCH --job-name="test_script_basic"

# Send yourself an email when the job:
# aborts abnormally (fails)
#SBATCH --mail-type=FAIL
# begins
#SBATCH --mail-type=BEGIN
# ends successfully
#SBATCH --mail-type=END

# Use this email address:
#SBATCH --mail-user=enaegele@umich.edu

# Maximum number of tasks/CPU cores used by the job:
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1

# The total amount of memory in gigabytes in the job:
#SBATCH --mem=1g

# The maximum running time of the job in days-hours:mins:sec
#SBATCH --time=0-0:5:00

# The account which this job should run under:
#SBATCH --account="tewaria1"

# Partition for the job:
#SBATCH -p standard

# Run the job from the directory where it was launched (default)

# The job command(s):
module purge
module list
echo "Running on $SLURM_JOB_NODELIST"
echo "Running in $(pwd)"
source "$HOME/.conda/etc/profile.d/conda.sh"
conda activate "$HOME/.conda/envs/al-env-gpu"
which python
python test_script.py