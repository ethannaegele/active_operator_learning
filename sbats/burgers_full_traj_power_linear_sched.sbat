#!/bin/bash

#SBATCH --job-name=burgers_full_traj_power_linear_sched
#SBATCH --mail-user=enaegele@umich.edu
#SBATCH --mail-type=BEGIN,END,FAIL

## export=NONE makes it so that environments already active in the terminal do not affect the env setup here
#SBATCH --export=NONE

#SBATCH --account=tewaria0
#SBATCH --partition=gpu

#SBATCH --nodes=1
#SBATCH --gpus=v100:1
#SBATCH --cpus-per-gpu=1
## mem is CPU memory - the GPU automatically gets the entire VRAM
#SBATCH --mem=12GB

## wall time hours:minutes:seconds
#SBATCH --time=15:00:00
#SBATCH --output=outputs/%x_%j.out
#SBATCH --error=errors/%x_%j.err

###   Load software modules

module purge
module load mamba/py3.12
module list

####  Commands your job should run follow this line

cd /scratch/tewaria_root/tewaria0/enaegele/active_operator_learning

echo "Running on $SLURM_JOB_NODELIST"
echo "Running in $(pwd)"

## this line finds my wandb key
source ~/.secrets/wandb.env

source "$(conda info --base)/etc/profile.d/conda.sh"

conda activate /home/enaegele/.conda/envs/al-env-gpu2

echo "Python path:"
which python

echo "Python version:"
python --version

python -m scripts.al_submitit -m \
+experiment=burgers \
+experiment/sub_exp=power \
acquisition/data_schedule=linear \
prob_model/model_wrapper=fno_full_traj \
prob_model.model_wrapper.training_type=full_trajectory \
prob_model.unc_roll_out_mode=direct \
prob_model.model_wrapper.num_train_steps=40 \
prob_model.model_wrapper.model.traj_len=41 \
task.data_gen.num_initial_batches=1 \
task.data_gen.batch_size=200 \
acquisition.batch_size=200 \
num_al_iter=10 \
num_epochs=500 \
prob_model.model_wrapper.batch_size=64 \
wandb.name=burgers_full_traj_power_acq_10_iter_500_epochs_linear_sched \
prob_model.model_wrapper.optimizer.lr=3e-04 \
prob_model.model_wrapper.scheduler.warmup_epochs=10 \
prob_model.model_wrapper.scheduler.eta_min=1e-06 \
warm_start_weights=True \
hydra=base


