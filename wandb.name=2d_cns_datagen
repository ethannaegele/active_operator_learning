wandb:
  group: test
  name: null
  project: al4pde
seed: 23
num_epochs: 500
start_al_iter: 0
num_al_iter: 5
warm_start_weights: false
restore_checkpoint: false
checkpoint_file_name: latest.pt
checkpoint_id: c1papzmi
acquisition:
  data_schedule:
    _target_: al4pde.acquisition.data_schedule.ExponentialSchedule
    first_batch_num: ${task.data_gen.num_initial_batches}
  batch_size: ${task.data_gen.batch_size}
  unc_num_rollout_steps_rel: 1.0
  unc_eval_mode: mean
  _target_: al4pde.acquisition.random.Random
task:
  _target_: al4pde.tasks.task.Task
  data_path: data/data
  run_save_path: data/runs
  reduced_batch: 1
  reduced_resolution: 2
  reduced_resolution_t: 1
  initial_step: 1
  skip_initial_steps: 0
  use_test: false
  save_in_reduced_res: false
  data_gen:
    num_test_batches: 256
    num_initial_batches: 8
    batch_size: 16
  ic_gen:
    _target_: al4pde.tasks.ic_gen.ic_gen_2d_ns_rand.ICGenNSRand
    k_tot: 4
    xL: 0.0
    xR: 1.0
    yL: 0.0
    yR: 1.0
    zL: 0.0
    zR: 1.0
    nx: 128
    ny: 128
    nz: 1
    mach_min: 0.1
    mach_max: 1.0
    gamma: 1.6666666666666667
    d0Min: 0.1
    d0Max: 10.0
    T0Min: 0.1
    T0Max: 10.0
    init_field_type: rand
    constrain_max: true
    delDMin: 0.013
    delDMax: 0.26
    delPMin: 0.04
    delPMax: 0.8
  param_gen:
    _target_: al4pde.tasks.param_gen.PDEParamGenerator
    min_val:
    - 0.0001
    - 0.0001
    max_val:
    - 0.1
    - 0.1
    log_scale:
    - true
    - true
  sim:
    _target_: al4pde.tasks.sim.cfd.CFDSim
    pde_name: CFD_2D_Rand_S
    same_eta_zeta: false
    spatial_dim: 2
    ini_time: 0.0
    fin_time: 1.0
    dt: 0.05
    CFL: 0.3
    show_steps: 100
    if_second_order: 1.0
    bc: periodic
    gamma: 1.6666666666666667
    p_floor: 0.0001
prob_model:
  model_wrapper:
    batch_size: 64
    num_workers: 0
    val_period: 20
    vis_period: 1000
    t_train: 201
    step_batch: -1
    num_train_steps: 2
    max_grad_norm: 50
    norm_mode: first
    noise: 0.001
    noise_mode: constant
    loss:
      _target_: al4pde.models.loss.MSE
      normalize_channels: false
    scheduler:
      _target_: pdearena.lr_scheduler.LinearWarmupCosineAnnealingLR
      warmup_epochs: 0
      warmup_start_lr: 1.0e-08
      eta_min: 1.0e-05
      max_epochs: ${num_epochs}
    _target_: al4pde.models.fno_wrapper.FNOFullTrajectoryWrapper
    training_type: full_trajectory
    encode_pde_param_log: false
    block_grad: false
    add_one_step: false
    optimizer:
      _target_: torch.optim.Adam
      lr: 0.001
      weight_decay: 0.0
    model:
      if_conditional: true
      num_channels: 1
      modes: 12
      time_modes: 8
      width: 64
      padding: 2
      traj_len: 5
  _target_: al4pde.prob_models.ensemble.Ensemble
  num_models_ensemble: 1
  unc_roll_out_mode: direct
  adapt_unc_to_loss: true
  synchronized_training: false
  first_model_prediction: true

